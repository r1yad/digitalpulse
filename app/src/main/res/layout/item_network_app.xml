<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_net_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_nav_network"
        android:contentDescription="App Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_net_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chrome"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_net_app_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼ 120 MB   ▲ 24 MB"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_net_app_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="144 MB"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
