<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_usage_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_nav_usage"
        android:contentDescription="App Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_usage_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_usage_app_sessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 launches • Avg 8m"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_usage_app_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h 36m"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_set_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Limit"
            android:textColor="@color/accent_violet"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
