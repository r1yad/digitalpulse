<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rule_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube Daily Limit"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rule_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger when screen time exceeds 120m"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_rule_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/btn_delete_rule"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_muted"
        android:contentDescription="Delete"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
