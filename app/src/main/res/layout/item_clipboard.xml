<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:padding="14dp">

    <!-- Header: Category Badge, Timestamp, Actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_clip_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEXT"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_pill_active"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_clip_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tv_clip_category"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="10m ago"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_clip_pin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_muted"
                android:contentDescription="Pin"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_clip_copy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/accent_cyan"
                android:contentDescription="Copy"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_clip_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_muted"
                android:contentDescription="Delete"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Content -->
    <TextView
        android:id="@+id/tv_clip_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample clipboard copied text..."
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

</LinearLayout>
