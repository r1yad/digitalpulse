<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_ambient_mesh_dark"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_limit_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Daily Limit: YouTube"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DigitalPulse will send smart alerts at 75%, 90% and 100% of this limit."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/et_limit_minutes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_search"
        android:hint="Daily limit in minutes (e.g. 60)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp"
        android:inputType="number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="end">

        <TextView
            android:id="@+id/btn_cancel_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_save_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Limit"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_pill_active"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

</LinearLayout>
