<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="48dp"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_clear_all_notifs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_glass_button"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_primary"
            android:contentDescription="@string/clear_all_notifications" />
    </RelativeLayout>

    <!-- Permission Warning (if Notification Listener not granted) -->
    <LinearLayout
        android:id="@+id/banner_notif_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_card_elevated"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_notifications"
            app:tint="@color/accent_amber"
            android:contentDescription="Alert" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/permission_notification_desc"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/btn_grant_notif_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grant"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_glass_pill_active"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Glass Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_search"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_search_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_notifications"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginStart="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_clear_search"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted"
            android:visibility="gone"
            android:contentDescription="Clear" />
    </LinearLayout>

    <!-- Filter Toggle Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tab_notif_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All History"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_pill_active"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tab_notif_bookmarked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bookmarked"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_notifs_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_nav_notifications"
            app:tint="@color/text_muted"
            android:contentDescription="No Notifications" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_notifications_recorded"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Notifications List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp" />

</LinearLayout>
