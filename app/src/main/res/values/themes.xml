<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Liquid Glass Theme -->
    <style name="Theme.DigitalPulse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">#0B0E14</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorOnSecondary">#0B0E14</item>
        <item name="colorTertiary">@color/accent_emerald</item>

        <!-- Status & Navigation Bar for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@drawable/bg_ambient_mesh_dark</item>
    </style>
</resources>
